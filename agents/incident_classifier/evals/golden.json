{
  "agent": "RA-002",
  "version": "v1",
  "description": "Golden fixtures for Incident Classifier. Each case has an input alert + expected classification patterns. Confidence thresholds are lenient (>=0.30) so the suite passes across all tiers — Tier 1/2 with a real LLM and Tier 4 keyword fallback with the stub provider.",
  "cases": [
    {
      "id": "pod_restart_loop",
      "description": "Payment pod OOMKilled repeatedly — capacity/infrastructure issue.",
      "scenario": "payment-oom-loop",
      "input": {
        "alert_id": "ALT-C7-001",
        "service": "payment",
        "metric": "container_memory_usage_bytes",
        "value": 1960000000,
        "threshold": 2000000000,
        "timestamp": "2026-05-13T10:00:00Z",
        "source": "Prometheus",
        "labels": {
          "namespace": "otel-demo",
          "pod": "payment-7956b8bb6c-xyz"
        },
        "annotations": {
          "description": "pod has been OOMKilled 4 times in 10 minutes; memory at 98%"
        }
      },
      "expected": {
        "incident_type": "infrastructure",
        "min_confidence": 0.30,
        "routing_team": "Payments Team",
        "on_call_engineer_contains": "oncall@payments",
        "dependencies_contains": "currency"
      }
    },
    {
      "id": "checkout_5xx_spike_app_bug",
      "description": "Checkout 5xx spike caused by NullPointerException in OrderProcessor — application defect.",
      "scenario": "checkout-npe-spike",
      "input": {
        "alert_id": "ALT-C7-002",
        "service": "checkout",
        "metric": "http_requests_errored_total",
        "value": 480,
        "threshold": 50,
        "timestamp": "2026-05-13T10:01:00Z",
        "source": "Prometheus",
        "labels": {
          "namespace": "otel-demo"
        },
        "annotations": {
          "description": "NullPointerException in OrderProcessor.applyDiscount; stack trace at OrderProcessor.java:142; error rate at 12%"
        }
      },
      "expected": {
        "incident_type": "application",
        "min_confidence": 0.30,
        "routing_team": "Order Experience",
        "on_call_engineer_contains": "oncall@order-experience"
      }
    },
    {
      "id": "frontend_dns_failure",
      "description": "Frontend 503s from envoy due to DNS resolution failures for cart service — network issue.",
      "scenario": "frontend-dns-failures",
      "input": {
        "alert_id": "ALT-C7-003",
        "service": "frontend",
        "metric": "envoy_cluster_upstream_cx_connect_fail",
        "value": 220,
        "threshold": 10,
        "timestamp": "2026-05-13T10:02:00Z",
        "source": "Prometheus",
        "labels": {
          "namespace": "otel-demo"
        },
        "annotations": {
          "description": "503 upstream_connect_error from envoy; DNS lookup for cart.otel-demo.svc timing out"
        }
      },
      "expected": {
        "incident_type": "network",
        "min_confidence": 0.30,
        "routing_team": "Web Experience",
        "on_call_engineer_contains": "oncall@web-experience"
      }
    },
    {
      "id": "email_sendgrid_429",
      "description": "Email service hitting SendGrid 429 rate limits — external dependency degradation.",
      "scenario": "email-sendgrid-rate-limit",
      "input": {
        "alert_id": "ALT-C7-004",
        "service": "email",
        "metric": "sendgrid_api_response_429_total",
        "value": 142,
        "threshold": 5,
        "timestamp": "2026-05-13T10:03:00Z",
        "source": "Prometheus",
        "labels": {
          "vendor": "sendgrid"
        },
        "annotations": {
          "description": "SendGrid API returning 429 rate-limit responses for 15 minutes; transactional emails queued"
        }
      },
      "expected": {
        "incident_type": "external_dependency",
        "min_confidence": 0.30,
        "routing_team": "Communications",
        "on_call_engineer_contains": "oncall@communications"
      }
    },
    {
      "id": "recommendation_post_deploy_regression",
      "description": "Recommendation error rate spiked within 90s of deploy — change-related regression.",
      "scenario": "recommendation-deploy-regression",
      "input": {
        "alert_id": "ALT-C7-005",
        "service": "recommendation",
        "metric": "http_requests_errored_total",
        "value": 320,
        "threshold": 50,
        "timestamp": "2026-05-13T10:04:00Z",
        "source": "Prometheus",
        "labels": {
          "namespace": "otel-demo",
          "deploy": "a1f3c2"
        },
        "annotations": {
          "description": "error rate jumped 60x within 90s of deploy a1f3c2; rollback in progress"
        }
      },
      "expected": {
        "incident_type": "change_related",
        "min_confidence": 0.30,
        "routing_team": "Personalization Team",
        "on_call_engineer_contains": "oncall@personalization"
      }
    }
  ]
}
