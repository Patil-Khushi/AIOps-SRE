{
  "agent": "RA-001 (Alert Triage — triage + classification)",
  "version": "v2",
  "description": "Golden fixtures for the Alert Triage agent, which now runs the full 8-step triage flow AND incident classification on one alert. run() returns the triage verdict fields at top level (severity/team/ownership/runbook — the original RA-001 checks) plus the promoted classification fields (incident_type/routing_team/confidence). The first 8 cases assert the triage half; the last 5 assert both halves across all classification tiers (Tier-1/2 with a real LLM, Tier-4 keyword fallback under the stub). Classification confidence threshold is lenient (>=0.30) so the keyword fallback stays green under the stub provider.",
  "cases": [
    {
      "id": "payment_cpu_spike",
      "description": "Payment service CPU at 96% (above 80% threshold). Customer-facing.",
      "scenario": "payment-cpu-spike",
      "input": {
        "alert_id": "ALT-1001",
        "service": "payment",
        "metric": "CPU Usage",
        "value": 96,
        "threshold": 80,
        "timestamp": "2026-05-06T10:20:00Z",
        "source": "Prometheus",
        "labels": {
          "namespace": "otel-demo",
          "pod": "payment-7956b8bb6c-xyz"
        }
      },
      "expected": {
        "severity_in": [
          "Sev-1",
          "Sev-2"
        ],
        "assigned_team": "Payments Team",
        "assigned_engineer_contains": "oncall@payments",
        "min_confidence_score": 0.7,
        "recommended_runbook_contains": "payment",
        "status": "Active"
      }
    },
    {
      "id": "checkout_latency_p95_high",
      "description": "Checkout p95 latency 5500ms above 2000ms threshold. Customer-facing.",
      "scenario": "checkout-latency-high",
      "input": {
        "alert_id": "ALT-1002",
        "service": "checkout",
        "metric": "Latency p95",
        "value": 5500,
        "threshold": 2000,
        "timestamp": "2026-05-06T10:21:00Z",
        "source": "Prometheus",
        "labels": {
          "namespace": "otel-demo"
        }
      },
      "expected": {
        "severity_in": [
          "Sev-1",
          "Sev-2"
        ],
        "assigned_team": "Order Experience",
        "assigned_engineer_contains": "oncall@order-experience",
        "min_confidence_score": 0.7,
        "status": "Active"
      }
    },
    {
      "id": "ad_low_traffic_early_warning",
      "description": "Ad service traffic dipped; severity_hint says warning. Should be Sev-3/4.",
      "scenario": "ad-low-traffic",
      "input": {
        "alert_id": "ALT-1003",
        "service": "ad",
        "metric": "Request Rate",
        "value": 5,
        "threshold": 10,
        "severity_hint": "warning",
        "timestamp": "2026-05-06T10:22:00Z",
        "source": "Prometheus"
      },
      "expected": {
        "severity_in": [
          "Sev-3",
          "Sev-4"
        ],
        "assigned_team": "Ads Team",
        "assigned_engineer_contains": "oncall@ads",
        "min_confidence_score": 0.7,
        "status": "Active"
      }
    },
    {
      "id": "accounting_memory_high",
      "description": "Non-customer-facing service memory at 92%. Should be Sev-3.",
      "scenario": "accounting-memory-high",
      "input": {
        "alert_id": "ALT-1004",
        "service": "accounting",
        "metric": "Memory Usage",
        "value": 92,
        "threshold": 80,
        "timestamp": "2026-05-06T10:23:00Z",
        "source": "Prometheus"
      },
      "expected": {
        "severity_in": [
          "Sev-2",
          "Sev-3"
        ],
        "assigned_team": "Finance Systems",
        "status": "Active"
      }
    },
    {
      "id": "severity_hint_critical_direct",
      "description": "severity_hint=critical short-circuits the rule-based classifier to Sev-1 with confidence 0.95; no LLM consult.",
      "scenario": "payment-5xx-critical",
      "input": {
        "alert_id": "ALT-1005",
        "service": "payment",
        "metric": "HTTP 5xx Rate",
        "value": 1.5,
        "threshold": 0.2,
        "severity_hint": "critical",
        "timestamp": "2026-05-13T10:00:00Z",
        "source": "Prometheus",
        "labels": {
          "namespace": "otel-demo",
          "severity": "critical"
        }
      },
      "expected": {
        "severity": "Sev-1",
        "min_confidence_score": 0.9,
        "assigned_team": "Payments Team",
        "assigned_engineer_contains": "oncall@payments",
        "recommended_runbook_contains": "payment",
        "status": "Active"
      }
    },
    {
      "id": "cmdb_miss_unknown_service",
      "description": "Service not in mock CMDB; verdict must fall back to Platform On-Call (the agent's safety net).",
      "scenario": "unknown-service-latency",
      "input": {
        "alert_id": "ALT-1006",
        "service": "weather-forecast-service",
        "metric": "Latency p95",
        "value": 800,
        "threshold": 500,
        "timestamp": "2026-05-13T10:01:00Z",
        "source": "Prometheus"
      },
      "expected": {
        "assigned_team": "Platform On-Call",
        "status": "Active"
      }
    },
    {
      "id": "sev_4_below_threshold_boundary",
      "description": "value below threshold (ratio 0.875 < 1.0) on ad service; rule-based classifier returns Sev-4 deterministically.",
      "scenario": "ad-cpu-below-threshold",
      "input": {
        "alert_id": "ALT-1007",
        "service": "ad",
        "metric": "Request Rate",
        "value": 70,
        "threshold": 80,
        "timestamp": "2026-05-13T10:02:00Z",
        "source": "Prometheus"
      },
      "expected": {
        "severity": "Sev-4",
        "min_confidence_score": 0.7,
        "assigned_team": "Ads Team",
        "assigned_engineer_contains": "oncall@ads",
        "status": "Active"
      }
    },
    {
      "id": "severity_hint_p2_high",
      "description": "severity_hint=p2 maps to Sev-2 via rule-based mapping (confidence 0.90); customer-facing service with full CMDB + runbook hit.",
      "scenario": "cart-error-rate-p2",
      "input": {
        "alert_id": "ALT-1008",
        "service": "cart",
        "metric": "Error Rate",
        "value": 0.4,
        "threshold": 0.2,
        "severity_hint": "p2",
        "timestamp": "2026-05-13T10:03:00Z",
        "source": "Prometheus"
      },
      "expected": {
        "severity": "Sev-2",
        "min_confidence_score": 0.85,
        "assigned_team": "Order Experience",
        "assigned_engineer_contains": "oncall@order-experience",
        "recommended_runbook_contains": "cart",
        "status": "Active"
      }
    },
    {
      "id": "payment_oom_infra",
      "description": "Payment pod OOMKilled repeatedly — triage owns payment, classification calls it infrastructure.",
      "scenario": "payment-oom-loop",
      "input": {
        "alert_id": "ALT-CTC-001",
        "service": "payment",
        "metric": "container_memory_usage_bytes",
        "value": 1960000000,
        "threshold": 2000000000,
        "timestamp": "2026-05-13T10:00:00Z",
        "source": "Prometheus",
        "labels": {
          "namespace": "otel-demo",
          "pod": "payment-7956b8bb6c-xyz"
        },
        "annotations": {
          "description": "pod has been OOMKilled 4 times in 10 minutes; memory at 98%"
        }
      },
      "expected": {
        "affected_service": "payment",
        "assigned_team": "Payments Team",
        "status": "Active",
        "incident_type": "infrastructure",
        "routing_team": "Payments Team",
        "min_confidence": 0.30
      }
    },
    {
      "id": "checkout_npe_app",
      "description": "Checkout 5xx spike from a NullPointerException — triage owns checkout, classification calls it application.",
      "scenario": "checkout-npe-spike",
      "input": {
        "alert_id": "ALT-CTC-002",
        "service": "checkout",
        "metric": "http_requests_errored_total",
        "value": 480,
        "threshold": 50,
        "timestamp": "2026-05-13T10:01:00Z",
        "source": "Prometheus",
        "labels": {
          "namespace": "otel-demo"
        },
        "annotations": {
          "description": "NullPointerException in OrderProcessor.applyDiscount; stack trace at OrderProcessor.java:142; error rate at 12%"
        }
      },
      "expected": {
        "affected_service": "checkout",
        "assigned_team": "Order Experience",
        "status": "Active",
        "incident_type": "application",
        "routing_team": "Order Experience",
        "min_confidence": 0.30
      }
    },
    {
      "id": "frontend_dns_network",
      "description": "Frontend 503s from envoy on DNS failures — triage owns frontend, classification calls it network.",
      "scenario": "frontend-dns-failures",
      "input": {
        "alert_id": "ALT-CTC-003",
        "service": "frontend",
        "metric": "envoy_cluster_upstream_cx_connect_fail",
        "value": 220,
        "threshold": 10,
        "timestamp": "2026-05-13T10:02:00Z",
        "source": "Prometheus",
        "labels": {
          "namespace": "otel-demo"
        },
        "annotations": {
          "description": "503 upstream_connect_error from envoy; DNS lookup for cart.otel-demo.svc timing out"
        }
      },
      "expected": {
        "affected_service": "frontend",
        "assigned_team": "Web Experience",
        "status": "Active",
        "incident_type": "network",
        "routing_team": "Web Experience",
        "min_confidence": 0.30
      }
    },
    {
      "id": "email_sendgrid_external_dep",
      "description": "Email service hitting SendGrid 429s — triage owns email, classification calls it external_dependency.",
      "scenario": "email-sendgrid-rate-limit",
      "input": {
        "alert_id": "ALT-CTC-004",
        "service": "email",
        "metric": "sendgrid_api_response_429_total",
        "value": 142,
        "threshold": 5,
        "timestamp": "2026-05-13T10:03:00Z",
        "source": "Prometheus",
        "labels": {
          "vendor": "sendgrid"
        },
        "annotations": {
          "description": "SendGrid API returning 429 rate-limit responses for 15 minutes; transactional emails queued"
        }
      },
      "expected": {
        "affected_service": "email",
        "incident_type": "external_dependency",
        "routing_team": "Communications",
        "min_confidence": 0.30
      }
    },
    {
      "id": "recommendation_deploy_change",
      "description": "Recommendation errors spiked right after a deploy — triage owns recommendation, classification calls it change_related.",
      "scenario": "recommendation-deploy-regression",
      "input": {
        "alert_id": "ALT-CTC-005",
        "service": "recommendation",
        "metric": "http_requests_errored_total",
        "value": 320,
        "threshold": 50,
        "timestamp": "2026-05-13T10:04:00Z",
        "source": "Prometheus",
        "labels": {
          "namespace": "otel-demo",
          "deploy": "a1f3c2"
        },
        "annotations": {
          "description": "error rate jumped 60x within 90s of deploy a1f3c2; rollback in progress"
        }
      },
      "expected": {
        "affected_service": "recommendation",
        "assigned_team": "Personalization Team",
        "status": "Active",
        "incident_type": "change_related",
        "routing_team": "Personalization Team",
        "min_confidence": 0.30
      }
    }
  ]
}
