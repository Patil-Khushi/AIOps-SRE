{
  "agent": "RA-001",
  "version": "v1",
  "description": "Golden fixtures for Alert Triage. Each case has an input alert + expected verdict patterns. The harness checks patterns, not exact strings (LLM output is non-deterministic for non-stub providers).",
  "cases": [
    {
      "id": "payment_cpu_spike",
      "description": "Payment service CPU at 96% (above 80% threshold). Customer-facing.",
      "scenario": "payment-cpu-spike",
      "input": {
        "alert_id": "ALT-1001",
        "service": "payment",
        "metric": "CPU Usage",
        "value": 96,
        "threshold": 80,
        "timestamp": "2026-05-06T10:20:00Z",
        "source": "Prometheus",
        "labels": {
          "namespace": "otel-demo",
          "pod": "payment-7956b8bb6c-xyz"
        }
      },
      "expected": {
        "severity_in": [
          "Sev-1",
          "Sev-2"
        ],
        "assigned_team": "Payments Team",
        "assigned_engineer_contains": "oncall@payments",
        "min_confidence_score": 0.7,
        "recommended_runbook_contains": "payment"
      }
    },
    {
      "id": "checkout_latency_p95_high",
      "description": "Checkout p95 latency 5500ms above 2000ms threshold. Customer-facing.",
      "scenario": "checkout-latency-high",
      "input": {
        "alert_id": "ALT-1002",
        "service": "checkout",
        "metric": "Latency p95",
        "value": 5500,
        "threshold": 2000,
        "timestamp": "2026-05-06T10:21:00Z",
        "source": "Prometheus",
        "labels": {
          "namespace": "otel-demo"
        }
      },
      "expected": {
        "severity_in": [
          "Sev-1",
          "Sev-2"
        ],
        "assigned_team": "Order Experience",
        "assigned_engineer_contains": "oncall@order-experience",
        "min_confidence_score": 0.7
      }
    },
    {
      "id": "ad_low_traffic_early_warning",
      "description": "Ad service traffic dipped; severity_hint says warning. Should be Sev-3/4.",
      "scenario": "ad-low-traffic",
      "input": {
        "alert_id": "ALT-1003",
        "service": "ad",
        "metric": "Request Rate",
        "value": 5,
        "threshold": 10,
        "severity_hint": "warning",
        "timestamp": "2026-05-06T10:22:00Z",
        "source": "Prometheus"
      },
      "expected": {
        "severity_in": [
          "Sev-3",
          "Sev-4"
        ],
        "assigned_team": "Ads Team",
        "assigned_engineer_contains": "oncall@ads",
        "min_confidence_score": 0.7
      }
    },
    {
      "id": "accounting_memory_high",
      "description": "Non-customer-facing service memory at 92%. Should be Sev-3.",
      "scenario": "accounting-memory-high",
      "input": {
        "alert_id": "ALT-1004",
        "service": "accounting",
        "metric": "Memory Usage",
        "value": 92,
        "threshold": 80,
        "timestamp": "2026-05-06T10:23:00Z",
        "source": "Prometheus"
      },
      "expected": {
        "severity_in": [
          "Sev-2",
          "Sev-3"
        ],
        "assigned_team": "Finance Systems"
      }
    },
    {
      "id": "severity_hint_critical_direct",
      "description": "severity_hint=critical short-circuits the rule-based classifier to Sev-1 with confidence 0.95; no LLM consult.",
      "scenario": "payment-5xx-critical",
      "input": {
        "alert_id": "ALT-1005",
        "service": "payment",
        "metric": "HTTP 5xx Rate",
        "value": 1.5,
        "threshold": 0.2,
        "severity_hint": "critical",
        "timestamp": "2026-05-13T10:00:00Z",
        "source": "Prometheus",
        "labels": {
          "namespace": "otel-demo",
          "severity": "critical"
        }
      },
      "expected": {
        "severity": "Sev-1",
        "min_confidence_score": 0.9,
        "assigned_team": "Payments Team",
        "assigned_engineer_contains": "oncall@payments",
        "recommended_runbook_contains": "payment"
      }
    },
    {
      "id": "cmdb_miss_unknown_service",
      "description": "Service not in mock CMDB; verdict must fall back to Platform On-Call (the agent's safety net).",
      "scenario": "unknown-service-latency",
      "input": {
        "alert_id": "ALT-1006",
        "service": "weather-forecast-service",
        "metric": "Latency p95",
        "value": 800,
        "threshold": 500,
        "timestamp": "2026-05-13T10:01:00Z",
        "source": "Prometheus"
      },
      "expected": {
        "assigned_team": "Platform On-Call"
      }
    },
    {
      "id": "sev_4_below_threshold_boundary",
      "description": "value below threshold (ratio 0.875 < 1.0) on ad service; rule-based classifier returns Sev-4 deterministically.",
      "scenario": "ad-cpu-below-threshold",
      "input": {
        "alert_id": "ALT-1007",
        "service": "ad",
        "metric": "Request Rate",
        "value": 70,
        "threshold": 80,
        "timestamp": "2026-05-13T10:02:00Z",
        "source": "Prometheus"
      },
      "expected": {
        "severity": "Sev-4",
        "min_confidence_score": 0.7,
        "assigned_team": "Ads Team",
        "assigned_engineer_contains": "oncall@ads"
      }
    },
    {
      "id": "severity_hint_p2_high",
      "description": "severity_hint=p2 maps to Sev-2 via rule-based mapping (confidence 0.90); customer-facing service with full CMDB + runbook hit.",
      "scenario": "cart-error-rate-p2",
      "input": {
        "alert_id": "ALT-1008",
        "service": "cart",
        "metric": "Error Rate",
        "value": 0.4,
        "threshold": 0.2,
        "severity_hint": "p2",
        "timestamp": "2026-05-13T10:03:00Z",
        "source": "Prometheus"
      },
      "expected": {
        "severity": "Sev-2",
        "min_confidence_score": 0.85,
        "assigned_team": "Order Experience",
        "assigned_engineer_contains": "oncall@order-experience",
        "recommended_runbook_contains": "cart"
      }
    }
  ]
}
