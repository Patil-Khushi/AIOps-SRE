      {
        "name": "payment_latency_seconds",
        "expect": "p95 near timeout"
      }
    ],
    "logs": [
      {
        "level": "ERROR",
        "contains": "payment failed: gateway timeout"
      }
    ],
    "container": [],
    "trace": {
      "path": "ecommerce-payment-service -> mock-payment-gateway",
      "note": "span stalls on external gateway"
    }
  },
  "grading": {
    "match_any_keyword": [
      "gateway",
      "timeout",
      "external",
      "dependency",
      "slow"
    ],
