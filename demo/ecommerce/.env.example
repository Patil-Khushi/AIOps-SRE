# ---------------------------------------------------------------------------
# ecommerce — environment configuration
# Copy to `.env` (never commit .env) and adjust as needed:
#     cp .env.example .env
# ---------------------------------------------------------------------------

# --- Host ports (change if something else is already using them) ------------
FRONTEND_PORT=3000
USER_SERVICE_PORT=8001
ORDER_SERVICE_PORT=8002
PAYMENT_SERVICE_PORT=8003
GATEWAY_PORT=8004
MYSQL_PORT=3306
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- MySQL (User Service) ---------------------------------------------------
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_USER=appuser
MYSQL_PASSWORD=apppass
MYSQL_DATABASE=users

# --- PostgreSQL (Order Service) ---------------------------------------------
POSTGRES_USER=appuser
POSTGRES_PASSWORD=apppass
POSTGRES_DB=orders

# --- Auth (User Service) ----------------------------------------------------
JWT_SECRET=change-me-in-prod
JWT_EXPIRY_MINUTES=60

# --- Inter-service timeouts -------------------------------------------------
PAYMENT_TIMEOUT_SECONDS=5      # order-service -> payment-service call timeout
GATEWAY_TIMEOUT_SECONDS=5      # payment-service -> mock-gateway call timeout

# --- Observability ----------------------------------------------------------
# OTLP/gRPC endpoint for trace export. Leave blank to disable tracing.
#
# For the k3s observability stack, use the NodePort bridge:
#     kubectl apply -f observability/nodeports.yaml
#     OTEL_EXPORTER_OTLP_ENDPOINT=http://192.168.127.2:30317
#
# 192.168.127.2 is the Rancher Desktop k3s node as seen from the Compose
# network (same VM subnet), so no port-forward is required. Confirm the node IP
# with `kubectl get nodes -o wide` if traces don't arrive.
#
# Verified working: a single POST /orders trace spans order-service ->
# user-service (GET /profile) -> payment-service (POST /payments).
OTEL_EXPORTER_OTLP_ENDPOINT=

# ===========================================================================
# FAILURE INJECTION TOGGLES
# All default to "off". Flip these (or set via failure_injection/ scripts) to
# reproduce each scenario. Leave everything off for normal operation.
# ===========================================================================

# --- User Service -----------------------------------------------------------
USER_INJECT_LATENCY_SECONDS=0     # >0 adds artificial delay to /login (Failure 2)
USER_INJECT_CPU_LOAD=false        # true = busy-loop to spike CPU (Failure 3)
# Failure 1 (MySQL down)  -> `docker compose stop mysql`
# Failure 4 (CrashLoop)   -> set a bad MYSQL_HOST / remove a required env var

# --- Order Service ----------------------------------------------------------
ORDER_INJECT_HTTP_500=false       # true = force 5xx on order creation (Failure 3)
ORDER_INJECT_MEMORY_LEAK=false    # true = unbounded allocation -> OOM (Failure 4)
# Failure 1 (Postgres down)    -> `docker compose stop postgres`
# Failure 2 (Payment timeout)  -> set GATEWAY_INJECT_DELAY_SECONDS above PAYMENT_TIMEOUT_SECONDS

# --- Payment Service --------------------------------------------------------
PAYMENT_INJECT_HTTP_500=false     # true = force 5xx on payment (Failure 4)
PAYMENT_INJECT_CPU_LOAD=false     # true = busy-loop to spike CPU (Failure 3)
# Failure 1 (Redis down)        -> `docker compose stop redis`
# Failure 2 (Gateway timeout)   -> set GATEWAY_INJECT_DELAY_SECONDS below

# --- Mock Payment Gateway ---------------------------------------------------
GATEWAY_INJECT_DELAY_SECONDS=0    # >0 simulates a slow external processor
