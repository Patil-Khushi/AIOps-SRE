# Order Service — standalone env (compose supplies these in the full stack)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=appuser
POSTGRES_PASSWORD=apppass
POSTGRES_DB=orders

# Downstream services
USER_SERVICE_URL=http://localhost:8001
PAYMENT_SERVICE_URL=http://localhost:8003
PAYMENT_TIMEOUT_SECONDS=5      # how long to wait on the payment call

# --- Failure injection toggles (default off) ---
INJECT_HTTP_500=false          # true = force 5xx on POST /orders  (Failure 3)
INJECT_MEMORY_LEAK=false       # true = leak memory on each order  (Failure 4: OOM)
# Failure 1 (Postgres down):   stop the postgres container
# Failure 2 (Payment timeout): set GATEWAY_INJECT_DELAY_SECONDS on the gateway
#                              above PAYMENT_TIMEOUT_SECONDS here

# --- Observability ---
OTEL_SERVICE_NAME=ecommerce-order-service
OTEL_EXPORTER_OTLP_ENDPOINT=