# Payment Service — standalone env (compose supplies these in the full stack)
REDIS_HOST=localhost
REDIS_PORT=6379

# External processor
GATEWAY_URL=http://localhost:8004
GATEWAY_TIMEOUT_SECONDS=5      # how long to wait on the gateway call

# --- Failure injection toggles (default off) ---
INJECT_HTTP_500=false          # true = force 5xx on POST /payments (Failure 4)
INJECT_CPU_LOAD=false          # true = busy-loop on /payments      (Failure 3)
# Failure 1 (Redis down):      stop the redis container
# Failure 2 (Gateway timeout): set INJECT_DELAY_SECONDS on the gateway above
#                              GATEWAY_TIMEOUT_SECONDS here

# --- Observability ---
OTEL_SERVICE_NAME=ecommerce-payment-service
OTEL_EXPORTER_OTLP_ENDPOINT=
# Blank disables that leg. Both backends are reached directly — no collector,
# no Promtail. See ../.env.example for the k3s NodePort values.
LOKI_URL=
LOKI_NAMESPACE=ecommerce
