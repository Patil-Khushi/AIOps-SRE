# User Service — standalone env (compose supplies these in the full stack)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=appuser
MYSQL_PASSWORD=apppass
MYSQL_DATABASE=users

JWT_SECRET=change-me-in-prod
JWT_EXPIRY_MINUTES=60

# --- Failure injection toggles (default off) ---
INJECT_LATENCY_SECONDS=0      # >0 adds delay to /login   (Failure 2: high latency)
INJECT_CPU_LOAD=false         # true = busy-loop on /login (Failure 3: high CPU)
# Failure 1 (MySQL down): stop the mysql container
# Failure 4 (CrashLoop):  set a bad MYSQL_HOST or remove JWT_SECRET

# --- Observability ---
OTEL_SERVICE_NAME=ecommerce-user-service
OTEL_EXPORTER_OTLP_ENDPOINT=
# Blank disables that leg. Both backends are reached directly — no collector,
# no Promtail. See ../.env.example for the k3s NodePort values.
LOKI_URL=
LOKI_NAMESPACE=ecommerce
