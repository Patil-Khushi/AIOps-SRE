# ─── LLM provider ────────────────────────────────────────────────────────
# Canonical default = anthropic / claude-sonnet-4-6 (aligned with
# aiops/llm/base.py:75 and aiops/llm/anthropic_provider.py). Swap to
# 'openai' or 'ollama' below if you prefer those; the gateway dispatches
# by AIOPS_LLM_PROVIDER.
AIOPS_LLM_PROVIDER=anthropic    # anthropic | openai | ollama | stub
AIOPS_LLM_MODEL=claude-sonnet-4-6

# Anthropic (default provider — used unless AIOPS_LLM_PROVIDER is changed)
ANTHROPIC_API_KEY=

# Anthropic via Azure AI Foundry
# Set ANTHROPIC_BASE_URL to the *.azure.com endpoint and the anthropic provider
# automatically rewrites auth headers for Foundry (see aiops/llm/anthropic_provider.py).
# When unset, the provider talks to api.anthropic.com directly.
ANTHROPIC_BASE_URL=

# Azure OpenAI (alternative provider — set AIOPS_LLM_PROVIDER=openai to enable)
# The openai provider auto-detects Azure when AZURE_OPENAI_ENDPOINT is set
# (aiops/llm/openai_provider.py). Credential precedence: AZURE_OPENAI_API_KEY > OPENAI_API_KEY.
# Model resolution: AIOPS_LLM_MODEL > AZURE_OPENAI_DEPLOYMENT_NAME > OPENAI_MODEL > gpt-4o.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_API_VERSION=2024-10-21

# OpenAI (alternative — used when AZURE_OPENAI_ENDPOINT is unset and provider=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Ollama (local fallback — no key)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Cost / safety caps applied by aiops/llm
AIOPS_LLM_MAX_TOKENS_PER_CALL=4096

# HITL default
AIOPS_HITL_DEFAULT=optional      # none | optional | required

# Shared secret that gates POST /api/approvals/{id}/approve|deny on the
# demo server (HITL-2, issue #102). When unset the server logs a loud
# WARNING at startup and accepts every request — fine for a localhost
# demo, not fine when other processes can reach :8765. When set, the
# React approver console attaches it as `Authorization: Bearer <token>`;
# compared constant-time via hmac.compare_digest. Pick anything with
# >=32 bytes of entropy, e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
AIOPS_HITL_APPROVAL_TOKEN=

# Persistent state (aiops.state). SQLite file by default; swap to
# postgresql+psycopg://user:pw@host/db when Phase 2 promotes to Postgres.
AIOPS_STATE_DB_URL=sqlite:///./data/state.db

# ─── Observability seam (Prometheus + Jaeger + Loki) ─────────────────────
# Defaults match the kubectl port-forwards in start.ps1; override for a
# self-hosted cluster bringing its own Prom/Jaeger/Loki. Timeouts apply to the
# httpx GETs in aiops/tools/observability/{prometheus,jaeger,loki}.py and to
# the Jaeger/Loki seams' connect-phase caps (#113).
AIOPS_PROMETHEUS_TIMEOUT=10
AIOPS_JAEGER_TIMEOUT=10
AIOPS_JAEGER_CONNECT_TIMEOUT=2
# Jaeger HTTP base. Demo defaults match the kubectl port-forward.
AIOPS_JAEGER_URL=http://localhost:16686
# MUST BE EMPTY for the standalone Jaeger in infra/observability/, which serves
# its query API at the root (/api/services).
#
# The OTel Demo's bundled Jaeger v2 used base_path: /jaeger/ui, so this was
# "/jaeger/ui" before that chart was removed. Setting it wrongly is a silent
# failure: every lookup 404s, and the agent reports "no traces" rather than a
# misconfiguration.
AIOPS_JAEGER_API_PREFIX=
# Loki HTTP base (RA-007 Log Correlation logs backend). Demo default matches
# the kubectl port-forward added by start.ps1 / infra/port-forward.ps1.
AIOPS_LOKI_URL=http://localhost:3100
AIOPS_LOKI_TIMEOUT=10
AIOPS_LOKI_CONNECT_TIMEOUT=2

# ─── SCM / source access (aiops/tools/scm) ───────────────────────────────
# Read-only GitHub access so agents can correlate an incident against what
# actually changed — the signal metrics/logs/traces cannot provide.
# Unset, every scm.* call returns ok=False and the platform runs fine without
# change correlation.
#
# Token: a FINE-GRAINED PAT scoped to this one repository, with
# Contents:Read + Metadata:Read and nothing else. The seam only ever issues
# GET, but the token is what actually enforces that — do not grant write.
AIOPS_GITHUB_REPO=Patil-Khushi/AIOps-SRE
AIOPS_GITHUB_TOKEN=
# Branch that scm.* reads by default. Set this to the branch the DEPLOYED code
# is on. Point it at a branch the code is not on and change correlation returns
# an empty commit list, which reads as "nothing changed" rather than as an
# error — the most misleading possible answer during an incident.
AIOPS_GITHUB_REF=main
AIOPS_GITHUB_TIMEOUT=10
AIOPS_GITHUB_CONNECT_TIMEOUT=3
# Longer than the Loki/Jaeger breakers (30s): a GitHub 403 usually means a
# secondary rate limit, and retrying quickly makes the block worse.
AIOPS_GITHUB_CIRCUIT_OPEN_SECONDS=60
# Skip files larger than this. A 400 KB lockfile is expensive and useless as
# LLM context.
AIOPS_GITHUB_MAX_FILE_BYTES=131072
# For GitHub Enterprise Server, e.g. https://github.example.com/api/v3
AIOPS_GITHUB_API_URL=https://api.github.com

# ─── Demo UI ─────────────────────────────────────────────────────────────
# FastAPI port (uvicorn). Precedence in start.ps1: explicit -UiPort flag >
# $env:AIOPS_UI_PORT (must be set in the *shell* before running start.ps1
# — PowerShell does not auto-load .env) > 8765.  Example:
#   $env:AIOPS_UI_PORT = 9000; .\start.ps1
AIOPS_UI_PORT=8765
# Seconds between WebSocket alert pushes from /ws/alerts. Lower for snappier
# demo UX; higher to reduce load on the Prometheus port-forward.
AIOPS_ALERT_BROADCAST_INTERVAL=5

# ─── ServiceNow PDI (RA-003 Auto-Ticketing — aiops/tools/itsm/servicenow.py) ──
# Provision a free PDI at https://developer.servicenow.com/ then create an
# aiops_agent user with the `itil` role; basic-auth creds go here.
AIOPS_SERVICENOW_INSTANCE_URL=
AIOPS_SERVICENOW_USER=
AIOPS_SERVICENOW_PASSWORD=
AIOPS_SERVICENOW_TIMEOUT=15

# Optional custom field on cmdb_ci_service that carries a runbook URL.
# Stock PDIs don't ship with this column; leave the default and the agent
# falls back to its on-call routing when the field is absent.
AIOPS_SERVICENOW_RUNBOOK_FIELD=u_runbook_url

# Toggle the mock CMDB lookup. true = use the static table in aiops/tools/
# mock_providers.py (CI / no-PDI default). false = let the real ServiceNow
# client in aiops/tools/itsm/ own itsm.cmdb.lookup. Set false once PDI creds
# above are filled in.
AIOPS_USE_MOCK_ITSM=false

# ─── Chatops sinks (RA-005 Notification Router) ─────────────────────────
# Slack incoming webhook URL (CHAT-1, issue #81). Optional — if unset, the
# WebSocket dashboard panel + JSONL audit log adapters keep working without
# Slack.
#
# Setup (~5 min, free):
#   1. Create a free Slack workspace at slack.com (or reuse personal)
#   2. https://api.slack.com/apps -> "Create New App" -> "From scratch"
#   3. Enable "Incoming Webhooks" -> "Add New Webhook to Workspace"
#   4. Pick a channel (e.g. #aiops-poc-alerts), copy the URL below
AIOPS_SLACK_WEBHOOK_URL=
AIOPS_SLACK_TIMEOUT=5

# Slack interactive HITL approval (Approve/Deny buttons in Slack).
# Required only if you want to approve/deny RCA fix steps from Slack instead
# of the /hitl page. Leaving it unset keeps the web approval flow working —
# Slack button clicks just won't be accepted (the callback 401s).
#
# Setup (in addition to the incoming webhook above):
#   1. api.slack.com/apps -> your app -> Basic Information -> App Credentials
#      -> "Signing Secret" -> Show -> copy below.
#   2. api.slack.com/apps -> your app -> Interactivity & Shortcuts -> toggle On
#      -> Request URL = https://<public-url>/api/approvals/slack/callback
#      (<public-url> = an ngrok/cloudflared tunnel to localhost:8765, since
#       Slack POSTs the button click to your machine over the internet).
AIOPS_SLACK_SIGNING_SECRET=

# Slack @mention → user ID mapping (CHAT-6, issue #86). When RA-005 routes
# a notification with assigned_engineer=chinmay, the chatops seam emits a
# mention like "@chinmay". Slack renders that as literal text — the real
# user does NOT get a native notification. Only the "<@U_ID>" form pings
# someone for real.
#
# aiops/tools/chatops/adapters/slack_users.json carries PLACEHOLDER IDs
# (UPLACEHOLDER1..UPLACEHOLDER5) — committing real workspace IDs would
# put them in git history. AIOPS_SLACK_USER_MAP_JSON below holds the
# real handle->user-id mapping in .env.shared (encrypted via git-crypt),
# and the chatops adapters merge it on top of the file at startup. Both
# the webhook and bot adapters consume the same merged map.
#
# Find a user's ID via Slack -> profile -> "..." menu -> "Copy member ID"
# (starts with U for users, W for guests). Shape: a JSON object on ONE
# line, e.g.
#   AIOPS_SLACK_USER_MAP_JSON={"chinmay":"U0ABC...","riya":"U0XYZ...","chinmay@example.com":"U0ABC..."}
# Keep the @example.com email keys too — RA-005 emits emails as
# fallback mentions when no slack_handle is recorded.
AIOPS_SLACK_USER_MAP_JSON=

# Slack Bot User OAuth Token (ON-CALL-2) — enables PERSONAL DMs to the
# on-call engineer on page_oncall actions, on top of the channel post.
# Set the bot's "Bot Token Scopes" to include chat:write and im:write,
# then install/reinstall to workspace and paste the xoxb-... token here.
# Optional; if unset, only the channel webhook + JSONL + WebSocket fire.
AIOPS_SLACK_BOT_TOKEN=
AIOPS_SLACK_BOT_TIMEOUT=5

# ─── On-call roster (RA-005 specialist routing) ─────────────────────────
# scripts/seed_oncall.py ships PLACEHOLDER engineers (Chinmay/Riya/Arjun/
# Meera/Vikram with @example.com emails and UPLACEHOLDER Slack IDs).
# Real workspace identities live here, in .env.shared (encrypted via
# git-crypt), and override the placeholder fields name/email/slack_handle/
# slack_user_id at seed time. Team / skills / timezone stay in code.
#
# Shape: a JSON object keyed by the stable engineer 'key' (chinmay /
# riya / arjun / meera / vikram), on ONE line. Example:
#   AIOPS_ONCALL_ROSTER_JSON={"chinmay":{"name":"Chinmay K","email":"chinmay@org.com","slack_handle":"@chinmay-k","slack_user_id":"U0..."},"riya":{...}}
# Only the four fields above are honoured; other fields are ignored.
# Run `uv run python -m scripts.seed_oncall --force` after editing.
AIOPS_ONCALL_ROSTER_JSON=

# PagerDuty Events API v2 integration key (CHAT-5, issue #85). Optional —
# if unset, RA-005's `page_oncall` action stays metadata-only. With it,
# Sev-1 (and after-hours Sev-2) alerts actually trigger PD incidents that
# wake the on-call engineer. The adapter only fires when the routing
# decision includes `page_oncall`, so chat-only Sev-3 / Sev-4 traffic
# never creates PD incidents.
#
# Setup (~10 min, free):
#   1. Sign up at https://developer.pagerduty.com/ (no credit card)
#   2. Create a service in the PD dashboard
#   3. Attach an "Events API v2" integration; copy the 32-char key below
#   4. Add yourself to the service's on-call schedule
AIOPS_PAGERDUTY_INTEGRATION_KEY=
AIOPS_PAGERDUTY_TIMEOUT=5

# Behind a corporate TLS-inspection proxy (Zscaler / Netskope / etc.)?
# Python's bundled certifi store rejects re-signed certs that the OS trusts.
# `truststore` patches the ssl module to use the OS trust store instead, so
# httpx / openai SDK / etc. work without disabling verification. Added in
# demo/ui/server.py — installed via `uv add truststore` and otherwise no
# config needed. Listed here so devs on corporate networks know it exists.
#
# Caveat: `truststore.inject_into_ssl()` is a process-wide ssl-module
# mutation that affects every TLS connection made from this Python process
# (not just our adapters). On a hardened production host you'd use the
# vendor SDK's own cert-bundle setting instead — fine for the POC, worth
# revisiting before any non-dev deployment.
